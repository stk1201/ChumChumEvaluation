<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".DetailResultActivity">

    <ImageButton
        android:id="@+id/imageView"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="345dp"
        android:backgroundTint="#FFFFFF"
        android:contentDescription="Home button"
        android:onClick="homeButtonTapped"
        android:scaleType="fitCenter"
        android:src="@drawable/home_icon"
        app:layout_constraintBottom_toTopOf="@+id/scrollView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/rank"
                android:layout_width="200dp"
                android:layout_height="90dp"
                android:layout_gravity="left"
                android:src="@drawable/normal" />

            <TextView
                android:id="@+id/musicNameView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="曲名"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/dateView"
                android:layout_width="150dp"
                android:layout_height="20dp"
                android:layout_gravity="right"
                android:text="日付"
                android:textSize="15dp" />

            <TextView
                android:id="@+id/sogoView"
                android:layout_width="150dp"
                android:layout_height="60dp"
                android:layout_gravity="left"
                android:gravity="center"
                android:text="総合"
                android:textSize="20dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView
                    android:id="@+id/totalScoreView"
                    android:layout_width="150dp"
                    android:layout_height="70dp"
                    android:gravity="center"
                    android:text="100"
                    android:textSize="50dp" />

                <TextView
                    android:id="@+id/tenView"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:text="点"
                    android:textSize="30dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/blank1View"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:gravity="center" />

            <ImageView
                android:id="@+id/graph"
                android:layout_width="300dp"
                android:layout_height="150dp"
                tools:srcCompat="@tools:sample/avatars"/>

            <TextView
                android:id="@+id/blank2View"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/besutoView"
                android:layout_width="200dp"
                android:layout_height="40dp"
                android:layout_gravity="left"
                android:gravity="center"
                android:text="ベストショット"
                android:textSize="20dp" />

            <LinearLayout
                android:layout_width="400dp"
                android:layout_height="178dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/userbestView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxWidth="300dp"
                    app:layout_constraintDimensionRatio="9:16"
                    tools:srcCompat="@tools:sample/avatars" />

                <ImageView
                    android:id="@+id/originalbestView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxWidth="300dp"
                    app:layout_constraintDimensionRatio="9:16"
                    tools:srcCompat="@tools:sample/avatars" />

            </LinearLayout>

            <TextView
                android:id="@+id/nobishiroView"
                android:layout_width="200dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="伸びしろショット"
                android:textSize="20dp" />

            <LinearLayout
                android:layout_width="400dp"
                android:layout_height="178dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/userworstView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxWidth="300dp"
                    app:layout_constraintDimensionRatio="9:16"
                    tools:srcCompat="@tools:sample/avatars" />

                <ImageView
                    android:id="@+id/originalworstView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxWidth="300dp"
                    app:layout_constraintDimensionRatio="9:16"
                    tools:srcCompat="@tools:sample/avatars" />

            </LinearLayout>

            <ImageView
                android:id="@+id/image2View"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="left"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                android:onClick="backHistoryButtonTapped"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.044"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/back" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
